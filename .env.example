# TRIAGE - full-fledged local run template (copy to .env and fill in).
#
# Hardware target: single consumer GPU (e.g., RTX 4070 Ti, 12 GB) + ollama.
#   generator  : fully local  (ollama llama3.1:8b, ~5 GB VRAM)
#   judge      : cloud        (Qwen/Qwen2.5-72B-Instruct via HF Inference
#                              Providers, pay-per-token, ~$2 per 50-sample run)
#   telemetry  : W&B online   (all metrics, win-rates, NDCG/McNemar/citation
#                              precision streamed to wandb.ai)
#   JEV gate   : cloud        (live typesafe.ai gate when key present;
#                              otherwise runs in local calibrated mode)

# --- required ---------------------------------------------------------------
NVIDIA_API_KEY=            # not used when LLM_PROVIDER=ollama; keep for fallback
HF_TOKEN=hf_xxx            # judge auth + SapBERT hub downloads
LLM_PROVIDER=ollama        # generator provider: ollama (local) | nvidia | huggingface
JUDGE_PROVIDER=huggingface # judge override: huggingface (72B cloud) | nvidia | (unset = follow LLM_PROVIDER)

# --- telemetry ---------------------------------------------------------------
WANDB_API_KEY=             # set this and leave WANDB_MODE unset => runs stream online
WANDB_PROJECT=hcad-rag     # or "triage" if you rename the project
# WANDB_ENTITY=your_team   # unset => personal namespace

# --- optional ----------------------------------------------------------------
# TYPESAFE_API_KEY=         # live JEV System One gate; omit => local calibrated mode
# WANDB_MODE=offline        # batch-sync later with `wandb sync` if internet is flaky

# Model overrides (defaults are sensible):
# LLM_NVIDIA_MODEL=meta/llama-3.1-8b-instruct      # when provider=nvidia
# JUDGE_NVIDIA_MODEL=qwen/qwen2.5-72b-instruct      # when judge provider=nvidia
# JUDGE_OLLAMA_MODEL=qwen2.5:72b                    # when judge follows ollama (needs big VRAM)
