# TRIAGE environment template. Copy to `.env`.
#
# ---------------------------------------------------------------------------
# PROFILE A - ALL LLMs LOCAL VIA OLLAMA, ZERO LLM API KEYS (default below)
# ---------------------------------------------------------------------------
#   generator : ollama llama3.1:8b   (~5 GB VRAM, free)
#   judge     : ollama qwen2.5:14b   (~9 GB Q4; drop to qwen2.5:7b if tight)
#
# Everything ELSE keeps its existing behavior: keep your other keys
# (WANDB_API_KEY => telemetry stays online, TYPESAFE_API_KEY => live JEV
# gate, NVIDIA_API_KEY => NIM fallback provider, HF_TOKEN => hub auth) —
# this profile only changes where the generator and judge run.
#
# Prereqs: ollama pull llama3.1:8b && ollama pull qwen2.5:14b
#
LLM_PROVIDER=ollama
JUDGE_OLLAMA_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# PROFILE B - OPTIONAL CLOUD-JUDGE UPGRADE (uncomment to switch)
# ---------------------------------------------------------------------------
# JUDGE_PROVIDER=huggingface    # judge => Qwen/Qwen2.5-72B-Instruct (HF cloud,
#                               # pay-per-token ~$2 per 50-sample run; paper parity)
#                               # requires HF_TOKEN + HF Inference Providers billing
# JUDGE_PROVIDER=nvidia         # ...or judge via NVIDIA NIM instead

# ---------------------------------------------------------------------------
# UNRELATED KNOBS (keep as-is unless you want to change them)
# ---------------------------------------------------------------------------
# WANDB_API_KEY=...             # set => W&B online (recommended)
# WANDB_MODE=disabled           # only if you want telemetry fully local
# TYPESAFE_API_KEY=...          # set => live JEV System One gate; omit => local calibrated mode
# NVIDIA_API_KEY=...            # NIM fallback if ollama is unavailable
# WANDB_PROJECT=hcad-rag

# Model overrides (defaults are sensible):
# LLM_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# JUDGE_NVIDIA_MODEL=qwen/qwen2.5-72b-instruct
